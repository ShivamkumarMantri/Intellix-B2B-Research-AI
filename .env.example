# ==============================================================================
# Intellix B2B Research AI - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your keys (both are 100% optional).
# When keys are omitted, the application runs seamlessly in Demo Evaluation Mode.

# ------------------------------------------------------------------------------
# 1. Web Research Engine (Optional)
# ------------------------------------------------------------------------------
# Tavily Search API Key for autonomous real-time public web crawling.
# Free 1,000 monthly credits available at: https://tavily.com
TAVILY_API_KEY=

# ------------------------------------------------------------------------------
# 2. LLM Intelligence Engine (Optional)
# ------------------------------------------------------------------------------
# OpenAI-compatible API key (Groq, OpenAI, Together AI, Ollama, etc.)
# Leave blank to use built-in offline heuristic AI synthesizers.
LLM_API_KEY=

# Base endpoint for OpenAI-compatible chat completions
# - Groq (Recommended fast free tier): https://api.groq.com/openai/v1
# - OpenAI: https://api.openai.com/v1
# - Ollama (Local): http://localhost:11434/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# Target model name
# - Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# - OpenAI: gpt-4o-mini, gpt-4o
LLM_MODEL=llama-3.3-70b-versatile
