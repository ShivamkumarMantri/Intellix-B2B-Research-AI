# ==============================================================================
# Streamlit Community Cloud - Secrets Configuration Template
# ==============================================================================
# In Streamlit Community Cloud:
# 1. Go to your App Dashboard -> App Settings -> Secrets
# 2. Paste the TOML configuration below (keys are optional)
# 3. Click Save

# [Optional] Tavily Search API Key for Live Web Research mode
# Free 1,000 monthly credits available at: https://tavily.com
TAVILY_API_KEY = ""

# [Optional] LLM API Key (Groq, OpenAI, Together AI, etc.)
# Leave blank to use built-in Demo Mode AI synthesizers
LLM_API_KEY = ""

# [Optional] OpenAI-compatible Base URL
LLM_BASE_URL = "https://api.groq.com/openai/v1"

# [Optional] Target model name
LLM_MODEL = "llama-3.3-70b-versatile"
